    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('If payment occured').all()[$itemIndex].json;\n\nreturn {\n  json: {\n    leadId: lead[\"Lead ID\"] || \"\",\n    fullName: lead[\"Full Name\"] || \"\",\n    email: lead[\"Email Address\"] || \"\",\n    phone: lead[\"WhatsApp / Phone\"] || \"\",\n    metaClickId: lead[\"Meta Click ID\"] || \"\",\n    paymentVerified: lead[\"Payment Verified?\"] || \"\",\n    eventTime: Math.floor(Date.now() / 1000)\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -16
      ],
      "id": "2de6baf1-bd66-4e24-b896-c18bc2b59ec1",
      "name": "prepare capi data",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "value": "={{ $json.email.trim().toLowerCase() }}",
        "dataPropertyName": "hashedEmail"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        192,
        32
      ],
      "id": "6249eafd-cf21-41e9-ab7c-f023be403bdb",
      "name": "Crypto"
    },
    {
      "parameters": {
        "value": "={{ String($json.phone).replace(/\\D/g, \"\") }}",
        "dataPropertyName": "hashedPhone"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        400,
        32
      ],
      "id": "b03a03cc-6a89-40ab-8332-c063dc4c7ecd",
      "name": "Crypto1",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const event = $json;\nconst leadId = String(event.leadId ?? \"\").trim();\nconst timestamp = Number(event.eventTime);\n\nif (!leadId) {\n  throw new Error(\"Missing leadId: cannot create a stable conversion event ID\");\n}\nif (!Number.isInteger(timestamp) || timestamp <= 0) {\n  throw new Error(\"Invalid event timestamp\");\n}\n\nconst userData = {};\nif (typeof event.hashedEmail === \"string\" && /^[a-f0-9]{64}$/i.test(event.hashedEmail)) {\n  userData.em = [event.hashedEmail.toLowerCase()];\n}\nif (typeof event.hashedPhone === \"string\" && /^[a-f0-9]{64}$/i.test(event.hashedPhone)) {\n  userData.ph = [event.hashedPhone.toLowerCase()];\n}\nif (!userData.em && !userData.ph) {\n  throw new Error(\"No valid hashed customer identifier for the Meta event\");\n}\n\n// fbc requires the formatted value, not an unformatted fbclid.\nif (typeof event.metaClickId === \"string\" && /^fb\\.1\\.\\d{10,13}\\..+/.test(event.metaClickId)) {\n  userData.fbc = event.metaClickId;\n}\n\nconst eventId = `${leadId}-SRM-PAYMENT-VERIFIED`;\nreturn {\n  json: {\n    data: [{\n      event_name: \"SRM Payment Verified\",\n      event_time: timestamp,\n      event_id: eventId,\n      action_source: \"system_generated\",\n      custom_data: {\n        event_source: \"crm\",\n        lead_event_source: \"Heart2Heart SRM\"\n      },\n      user_data: userData\n    }]\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        32
      ],
      "id": "bdb6db43-a8b8-4cc7-97db-20f48adfea2f",
      "name": "send CAPI event",
      "alwaysOutputData": true
    },
